<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} - r3yshellz BLOG</title>
    <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
    <!-- Menggunakan FontAwesome gratis untuk Ikon Menu & Sosial Media -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <!-- LEFT NAVBAR STATIS -->
    <aside class="sidebar">
        <div class="profile-section">
            <!-- Ganti src ini dengan nama file foto Anda nanti di folder src/img/ -->
            <img src="/img/profile.png" alt="Profile Photo" class="profile-pic">
            <p class="nickname">r3yshellz</p>
            <p class="motto">"Hunt Logic, Not Luck"</p>
        </div>
        
        <nav class="sidebar-nav" id="sidebar-nav">
            <a href="{{ '/' | url }}" class="nav-link"><i class="fa-solid fa-house"></i> HOMEPAGE</a>
            <a href="{{ '/writeups' | url }}" class="nav-link"><i class="fas fa-folder-open"></i> WRITEUPS</a>
            <a href="{{ '/profile' | url }}" class="nav-link"><i class="fas fa-user-shield"></i> PROFILE</a>
        </nav>

        <div class="social-icons">
            <a href="https://github.com/reyluchaabiell" target="_blank" title="GitHub"><i class="fab fa-github"></i></a>
            <a href="https://www.linkedin.com/in/reylucha-biel/" target="_blank" title="LinkedIn"><i class="fab fa-linkedin"></i></a>
            <a href="https://www.instagram.com/reylucha_biel/" target="_blank" title="Instagram"><i class="fab fa-instagram"></i></a>
            <a href="mailto:biellreyluchaa@gmail.com" title="Gmail"><i class="fas fa-envelope"></i></a>
        </div>
    </aside>

    <!-- KONTEN KANAN -->
    <main class="content-area">
        <div class="content-inner">
            {{ content | safe }}
        </div>
        
        <!-- FOOTER COPYRIGHT & DISCLAIMER -->
        <footer class="main-footer">
            <p style="margin-bottom: 50px; text-align: justify;"><strong style="color: red;">Disclaimer:</strong>  All information, techniques, and Proof of Concept (PoC) on this website are intended solely for educational and security research purposes. The author is not responsible for any misuse of this information.</p>
            <hr style="color: #F4EB6C;">
            <p style="margin-top: 10px;">&copy; 2026 Reylucha Biel / Cybersecurity Journey. All rights reserved.</p>
        </footer>
    </main>
    <script src="/js/script.js" defer></script>
</body>
</html>