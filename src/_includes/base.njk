<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#0b1114">
    <meta name="description" content="{{ description or site.description }}">
    <!-- CSP via meta (GitHub Pages cannot send headers). No inline scripts/styles are used anywhere. -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' https://cdnjs.cloudflare.com; font-src https://cdnjs.cloudflare.com; img-src 'self' data: https://www.hackthebox.com; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'">
    <title>{{ title }} - r3yshellz BLOG</title>
    <link rel="icon" href="data:,">
    <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
    <!-- Icon font only (decorative icons are aria-hidden) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <script src="{{ '/js/script.js' | url }}" defer></script>
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    <a class="skip-link" href="#main">Skip to content</a>

    <!-- SITE HEADER: sticky bar on mobile, fixed sidebar on desktop -->
    <header class="site-header">
        <a class="brand" href="{{ '/' | url }}" aria-label="r3yshellz - go to homepage">
            <img src="{{ '/img/profile.png' | url }}" alt="" class="profile-pic" width="1024" height="1024" decoding="async">
            <span class="brand-text">
                <span class="nickname">r3yshellz</span>
                <span class="motto">"Hunt Logic, Not Luck"</span>
            </span>
        </a>

        <nav class="primary-nav" aria-label="Primary">
            <a href="{{ '/' | url }}" class="nav-link"{% if page.url == '/' %} aria-current="page"{% endif %}><i class="fa-solid fa-house" aria-hidden="true"></i> <span>HOMEPAGE</span></a>
            <a href="{{ '/writeups' | url }}" class="nav-link"{% if page.url.startsWith('/writeups') %} aria-current="page"{% endif %}><i class="fas fa-folder-open" aria-hidden="true"></i> <span>WRITEUPS</span></a>
            <a href="{{ '/profile' | url }}" class="nav-link"{% if page.url.startsWith('/profile') %} aria-current="page"{% endif %}><i class="fas fa-user-shield" aria-hidden="true"></i> <span>PROFILE</span></a>
        </nav>

        <nav class="social-icons" aria-label="Social links">
            <a href="https://github.com/reyluchaabiell" target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in new tab)"><i class="fab fa-github" aria-hidden="true"></i></a>
            <a href="https://www.linkedin.com/in/reylucha-biel/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in new tab)"><i class="fab fa-linkedin" aria-hidden="true"></i></a>
            <a href="https://www.instagram.com/reylucha_biel/" target="_blank" rel="noopener noreferrer" aria-label="Instagram (opens in new tab)"><i class="fab fa-instagram" aria-hidden="true"></i></a>
            <a href="mailto:biellreyluchaa@gmail.com" aria-label="Send email"><i class="fas fa-envelope" aria-hidden="true"></i></a>
        </nav>
    </header>

    <div class="page">
        <main id="main" tabindex="-1">
            <div class="content-inner">
                {{ content | safe }}
            </div>
        </main>

        <footer class="main-footer">
            <p class="disclaimer"><strong class="warn">Disclaimer:</strong> All information, techniques, and Proof of Concept (PoC) on this website are intended solely for educational and security research purposes. The author is not responsible for any misuse of this information.</p>
            <p class="copyright">&copy; 2026 Reylucha Biel / Cybersecurity Journey. All rights reserved.</p>
        </footer>
    </div>
</body>
</html>
