---
layout: base.njk
bodyClass: writeup-page
---
{%- set shareUrl = (site.url or '') + (page.url | url) -%}
{%- set related = collections.writeups | related(category, page.url) -%}

<header class="writeup-hero">
    <div class="hero-meta">
        <span class="category-badge">{{ category }}</span>
        <span class="date-text"><i class="fas fa-calendar-alt" aria-hidden="true"></i> <time datetime="{{ date | isoDate }}">{{ date | tanggalIndo }}</time></span>
    </div>
    <h1 class="hero-title glitch">{{ title }}</h1>
    {% if tags %}
    <ul class="tag-list" aria-label="Tags">
        {% for tag in tags %}{% if tag != "writeups" %}
        <li class="tag-badge"><i class="fas fa-hashtag" aria-hidden="true"></i> {{ tag }}</li>
        {% endif %}{% endfor %}
    </ul>
    {% endif %}
</header>

{% if tldr %}
<aside class="tldr-box" aria-labelledby="tldr-title">
    <h2 id="tldr-title"><i class="fas fa-bolt" aria-hidden="true"></i> TL;DR (Executive Summary)</h2>
    <p>{{ tldr }}</p>
</aside>
{% endif %}

<article class="writeup-content prose">
    {{ content | safe }}
</article>

<section class="share-section" aria-labelledby="share-title">
    <h2 id="share-title"><i class="fas fa-share-alt" aria-hidden="true"></i> Share This Write-up</h2>
    <p>Found an interesting vulnerability or want to discuss it? Share this article with other security professionals:</p>
    <div class="share-buttons">
        <a href="https://twitter.com/intent/tweet?text={{ title | urlencode }}&url={{ shareUrl | urlencode }}" target="_blank" rel="noopener noreferrer" class="btn share-btn twitter"><i class="fab fa-x-twitter" aria-hidden="true"></i> X (Twitter)<span class="sr-only"> (opens in new tab)</span></a>
        <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ shareUrl | urlencode }}" target="_blank" rel="noopener noreferrer" class="btn share-btn linkedin"><i class="fab fa-linkedin-in" aria-hidden="true"></i> LinkedIn<span class="sr-only"> (opens in new tab)</span></a>
        <a href="https://api.whatsapp.com/send?text={{ (title + ' - ' + shareUrl) | urlencode }}" target="_blank" rel="noopener noreferrer" class="btn share-btn whatsapp"><i class="fab fa-whatsapp" aria-hidden="true"></i> WhatsApp<span class="sr-only"> (opens in new tab)</span></a>
        <button type="button" class="btn share-btn copy" data-copy>
            <i class="fas fa-link" aria-hidden="true"></i> <span class="copy-label" data-done="Copied!" aria-live="polite">Copy Link</span>
        </button>
    </div>
</section>

{% if related.length %}
<aside class="related-section" aria-labelledby="related-title">
    <h2 id="related-title"><i class="fas fa-link" aria-hidden="true"></i> Related Content</h2>
    <div class="card-grid">
        {% for post in related %}
        <article class="card">
            <span class="category-badge">{{ post.data.category }}</span>
            <h3><a class="card-link" href="{{ post.url | url }}">{{ post.data.title }}</a></h3>
        </article>
        {% endfor %}
    </div>
</aside>
{% endif %}
